{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [
				{ "slug": "base", "name": "Base", "color": "#f7f6f2" },
				{ "slug": "surface", "name": "Surface", "color": "#ffffff" },
				{ "slug": "contrast", "name": "Contrast", "color": "#16171a" },
				{ "slug": "muted", "name": "Muted", "color": "#55585f" },
				{ "slug": "line", "name": "Line", "color": "#dedcd4" },
				{ "slug": "accent", "name": "Accent", "color": "#2440d8" },
				{ "slug": "accent-contrast", "name": "On accent", "color": "#ffffff" }
			]
		},
		"layout": { "contentSize": "720px", "wideSize": "1200px" },
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2.5vw, 2rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 5vw, 4rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 8vw, 7rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "System sans",
					"fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.375rem" } },
				{ "slug": "x-large", "name": "Extra large", "size": "2.25rem", "fluid": { "min": "1.75rem", "max": "2.25rem" } },
				{ "slug": "display", "name": "Display", "size": "4rem", "fluid": { "min": "2.5rem", "max": "4rem" } }
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
		"spacing": {
			"padding": { "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" },
			"blockGap": "var:preset|spacing|30"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|body",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"heading": { "typography": { "fontWeight": "650", "lineHeight": "1.15" } },
			"h1": { "typography": { "fontSize": "var:preset|font-size|display", "letterSpacing": "-0.02em" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large", "letterSpacing": "-0.01em" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"button": {
				"color": { "background": "var:preset|color|accent", "text": "var:preset|color|accent-contrast" },
				"border": { "radius": "999px" },
				"spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
				"typography": { "fontWeight": "600", "textDecoration": "none" },
				":hover": { "color": { "background": "var:preset|color|contrast" } }
			}
		},
		"blocks": {
			"core/navigation": { "typography": { "fontSize": "var:preset|font-size|small" } },
			"core/site-title": { "typography": { "fontWeight": "700", "fontSize": "var:preset|font-size|medium" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
